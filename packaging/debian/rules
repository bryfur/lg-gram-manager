#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	# No build step needed for Python script

override_dh_auto_install:
	install -D -m 755 lg_gram_manager_gtk.py debian/lg-gram-manager/usr/bin/lg-gram-manager
	install -D -m 644 lg_gram_profiles.py debian/lg-gram-manager/usr/lib/python3/dist-packages/lg_gram_profiles.py
	install -D -m 644 lg_gram_profile_ui.py debian/lg-gram-manager/usr/lib/python3/dist-packages/lg_gram_profile_ui.py
	install -D -m 755 lg_gram_profiles.py debian/lg-gram-manager/usr/libexec/lg-gram-manager-profiles
	install -D -m 644 packaging/org.lg-gram-manager.profiles.policy debian/lg-gram-manager/usr/share/polkit-1/actions/org.lg-gram-manager.profiles.policy
	install -D -m 644 packaging/lg-gram-manager-boot.service debian/lg-gram-manager/lib/systemd/system/lg-gram-manager-boot.service
	install -D -m 644 packaging/org.lg-gram-manager.gtk.desktop debian/lg-gram-manager/usr/share/applications/org.lg-gram-manager.gtk.desktop
	install -D -m 644 packaging/org.lg-gram-manager.gtk.svg debian/lg-gram-manager/usr/share/icons/hicolor/scalable/apps/org.lg-gram-manager.gtk.svg
	install -D -m 644 packaging/org.lg-gram-manager.policy debian/lg-gram-manager/usr/share/polkit-1/actions/org.lg-gram-manager.policy
	install -D -m 644 packaging/99-lg-gram-manager.rules debian/lg-gram-manager/etc/udev/rules.d/99-lg-gram-manager.rules

override_dh_auto_clean:
	rm -rf __pycache__ *.egg-info
	dh_auto_clean

override_dh_auto_test:
	python3 -m unittest discover -s tests

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
